<Window x:Class="PureXS.Views.FacilitySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Facility Settings"
        Icon="/Assets/purechart_icon.ico"
        Width="620" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="560" MinHeight="360"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI">

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title -->
            <RowDefinition Height="Auto"/>  <!-- subtitle -->
            <RowDefinition Height="Auto"/>  <!-- column headers -->
            <RowDefinition Height="*"/>     <!-- rows -->
            <RowDefinition Height="Auto"/>  <!-- buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="PureChart Facilities"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="17" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   Text="Each facility authenticates with its own PureChart x-api-key. The active facility's patients populate the dock. Leave a name blank to auto-fill it from the server."
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="12" TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- Column headers -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Active" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="Name"   Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Token (x-api-key)" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1" CornerRadius="6" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0"
                                             GroupName="ActiveFacility"
                                             IsChecked="{Binding IsActive, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,6,0" Padding="6,4"
                                         FontSize="12"
                                         Background="{DynamicResource FieldBg}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource BorderSubtle}"
                                         CaretBrush="{DynamicResource TextPrimary}"/>

                                <TextBox Grid.Column="2"
                                         Text="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,6,0" Padding="6,4"
                                         FontSize="12" FontFamily="Consolas"
                                         Background="{DynamicResource FieldBg}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource BorderSubtle}"
                                         CaretBrush="{DynamicResource TextPrimary}"/>

                                <Button Grid.Column="3"
                                        Content="&#x2715;"
                                        Width="28" Height="26"
                                        Click="RemoveButton_Click"
                                        ToolTip="Remove facility"
                                        Background="#FEE2E2" Foreground="#B91C1C"
                                        BorderBrush="#FCA5A5"
                                        Cursor="Hand"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Button Content="+ Add Facility"
                    HorizontalAlignment="Left"
                    Width="130" Height="32"
                    Click="AddButton_Click"
                    Background="{DynamicResource ToolbarBtnBg}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    FontSize="13" Cursor="Hand"/>

            <TextBlock x:Name="StatusText"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#EF4444" FontSize="12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="84" Height="32" Margin="0,0,10,0"
                        IsCancel="True" Click="Cancel_Click"
                        Background="{DynamicResource ToolbarBtnBg}"
                        Foreground="{DynamicResource TextSecondary}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        FontSize="13" Cursor="Hand"/>
                <Button Content="Save"
                        Width="84" Height="32"
                        IsDefault="True" Click="Save_Click"
                        Background="{DynamicResource DentalBlue}"
                        Foreground="White"
                        BorderBrush="{DynamicResource DentalBlue}"
                        FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
